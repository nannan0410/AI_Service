{
  "version": "1.0",
  "fields": [
    {
      "fieldId": "personaId",
      "label": "演示账号",
      "valueType": "enum",
      "source": "mock_api",
      "enumOptions": [
        { "value": "demo_new", "label": "新客" },
        { "value": "demo_mid", "label": "中级会员" },
        { "value": "demo_vip", "label": "高级会员" }
      ],
      "ruleEligible": true,
      "group": "user"
    },
    {
      "fieldId": "scenicId",
      "label": "当前服务景区",
      "valueType": "enum",
      "source": "computed",
      "computeHint": "conversation.scenicId / X-Scenic-Id",
      "enumOptions": [
        { "value": "scenic_hlg", "label": "上海奇趣乐园" },
        { "value": "scenic_hy", "label": "上海海洋公园" },
        { "value": "scenic_sz_eco", "label": "深圳绿野公园" }
      ],
      "ruleEligible": true,
      "group": "visit"
    },
    {
      "fieldId": "memberLevel",
      "label": "会员等级",
      "valueType": "string",
      "source": "api",
      "computeHint": "当前账号会员主数据等级（演示 memberInfo.level）；规则 eq/in；非订单推导",
      "ruleEligible": true,
      "group": "user"
    },
    {
      "fieldId": "inPark",
      "label": "是否在园",
      "valueType": "boolean",
      "source": "computed",
      "computeHint": "正式：今日订单已核销 ∨ 票夹今日票已核销(实名倒查) ∨ GPS坐标落园区围栏；演示：visitorState.inPark。≠hasVisitToday",
      "ruleEligible": true,
      "group": "visit"
    },
    {
      "fieldId": "visitorPhase",
      "label": "游客阶段",
      "valueType": "enum",
      "source": "computed",
      "enumOptions": [
        { "value": "pre", "label": "出行前" },
        { "value": "in_park", "label": "在园" },
        { "value": "post_same_day", "label": "离园当日" },
        { "value": "post_later", "label": "离园后" }
      ],
      "ruleEligible": true,
      "group": "visit"
    },
    {
      "fieldId": "hasPendingVisitOrder",
      "label": "待出行（有待核销）",
      "valueType": "boolean",
      "source": "computed",
      "computeHint": "正式：订单待核销 ∨ 票夹待核销(实名倒查)；演示：paid/pending 且 visitDate>=今天。与inPark对偶(待核销vs已核销)，无GPS",
      "ruleEligible": true,
      "group": "order"
    },
    {
      "fieldId": "hasVisitToday",
      "label": "今日有待出行订单",
      "valueType": "boolean",
      "source": "computed",
      "computeHint": "orders: paid/pending 且 visitDate = 今天",
      "ruleEligible": true,
      "group": "order"
    },
    {
      "fieldId": "hasInvoiceableOrders",
      "label": "有可开票订单",
      "valueType": "boolean",
      "source": "computed",
      "computeHint": "当前账号已完成 ∧ invoiceStatus=none（未开票）；演示另加完成日90天内；正式排除OTA等不可开票渠道",
      "ruleEligible": true,
      "group": "order"
    },
    {
      "fieldId": "hasReviewableOrders",
      "label": "有可评价订单",
      "valueType": "boolean",
      "source": "computed",
      "computeHint": "当前账号已完成 ∧ reviewStatus=none（未评价）；演示另加完成日90天内",
      "ruleEligible": true,
      "group": "order"
    },
    {
      "fieldId": "hasNewGuestCoupon",
      "label": "已有可用新客券",
      "valueType": "boolean",
      "source": "computed",
      "computeHint": "coupons 含当前绑定新客券产品（演示：cp_prod_new 或 title=新客专享 20 元券）且 status=available；≠活动一次性资格",
      "ruleEligible": true,
      "group": "tag"
    },
    {
      "fieldId": "canClaimNewGuestCoupon",
      "label": "可领取新客券（展示用）",
      "valueType": "boolean",
      "source": "computed",
      "computeHint": "新客 ∧ 注册窗口内 ∧ 未消耗新客券活动一次性资格（与当前绑定券ID无关；演示近似：未持有cp_prod_new/同title）。入口显隐用；点击领取另校券ID限领",
      "ruleEligible": true,
      "group": "tag"
    },
    {
      "fieldId": "tags",
      "label": "用户标签",
      "valueType": "string[]",
      "source": "mock_api",
      "ruleEligible": true,
      "group": "tag"
    }
  ],
  "tags": [
    {
      "tagId": "new_guest",
      "name": "新客",
      "description": "首次来访用户",
      "demoPersonas": ["demo_new"]
    },
    {
      "tagId": "family",
      "name": "亲子",
      "description": "携带儿童或偏好亲子项目",
      "demoPersonas": ["demo_mid", "demo_vip"]
    },
    {
      "tagId": "high_value",
      "name": "高价值",
      "description": "高等级会员或高消费用户",
      "demoPersonas": ["demo_vip"]
    }
  ]
}
